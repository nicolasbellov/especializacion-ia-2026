<mxfile host="app.diagrams.net" modified="2026-10-20T00:00:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="u14b8" name="U1.4 - Bloque 8 - Gemini"><mxGraphModel dx="1860" dy="1280" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1455" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="head" value="&lt;b&gt;U1.4 · Bloque 8 · Arquitectura real — src/consumir_gemini.py&lt;/b&gt;&lt;br&gt;Flujo actual, seguridad, excepciones y costo manual" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=9;strokeColor=#DCE5EF;fillColor=#FFFFFF;fontColor=#15283D;fontSize=29;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="2100" height="125" as="geometry" /></mxCell><mxCell id="env" value="&lt;b&gt;Archivo .env&lt;/b&gt; / load_dotenv()&lt;br&gt;GEMINI_API_KEY → os.getenv() en armar_peticion&lt;br&gt;Cabecera: x-goog-api-key (sin revelar valor)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=9;strokeColor=#147D70;fillColor=#EAF8F4;fontColor=#15283D;fontSize=18;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="190" width="405" height="130" as="geometry" /></mxCell><mxCell id="usuario" value="&lt;b&gt;Usuario / CLI&lt;/b&gt;&lt;br&gt;pregunta: str&lt;br&gt;__main__ recorre preguntas" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=9;strokeColor=#175CD3;fillColor=#EDF4FF;fontColor=#15283D;fontSize=20;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="266" height="155" as="geometry" /></mxCell><mxCell id="orq" value="&lt;b&gt;obtener_dato_de_prueba(pregunta)&lt;/b&gt;&lt;br&gt;Orquesta las 3 funciones" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=9;strokeColor=#175CD3;fillColor=#EDF4FF;fontColor=#15283D;fontSize=20;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="346" y="390" width="305" height="155" as="geometry" /></mxCell><mxCell id="armar" value="&lt;b&gt;armar_peticion(pregunta)&lt;/b&gt;&lt;br&gt;Valida pregunta&lt;br&gt;retorna URL, headers, body" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=9;strokeColor=#175CD3;fillColor=#EDF4FF;fontColor=#15283D;fontSize=20;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="696" y="390" width="345" height="155" as="geometry" /></mxCell><mxCell id="enviar" value="&lt;b&gt;enviar_peticion(url, headers, body)&lt;/b&gt;&lt;br&gt;requests.post(timeout=30)&lt;br&gt;raise_for_status(); respuesta.json()" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=9;strokeColor=#175CD3;fillColor=#EDF4FF;fontColor=#15283D;fontSize=20;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1081" y="390" width="345" height="155" as="geometry" /></mxCell><mxCell id="extraer" value="&lt;b&gt;extraer_texto(datos)&lt;/b&gt;&lt;br&gt;candidates[0]...text&lt;br&gt;Devuelve string" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=9;strokeColor=#175CD3;fillColor=#EDF4FF;fontColor=#15283D;fontSize=20;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1466" y="390" width="345" height="155" as="geometry" /></mxCell><mxCell id="output" value="&lt;b&gt;Respuesta al usuario&lt;/b&gt;&lt;br&gt;resultado: str&lt;br&gt;print(&quot;Resultado:&quot;, ...)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=9;strokeColor=#175CD3;fillColor=#FFFFFF;fontColor=#15283D;fontSize=20;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1851" y="390" width="310" height="155" as="geometry" /></mxCell><mxCell id="api" value="&lt;b&gt;Gemini REST API&lt;/b&gt;&lt;br&gt;Tokenización → generación → texto&lt;br&gt;JSON: candidates + usageMetadata" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=9;strokeColor=#147D70;fillColor=#EAF8F4;fontColor=#15283D;fontSize=20;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1062" y="695" width="365" height="180" as="geometry" /></mxCell><mxCell id="costo" value="&lt;b&gt;calcular_costo(datos, precio_entrada, precio_salida)&lt;/b&gt;&lt;br&gt;Lee usageMetadata&lt;br&gt;Retorna costo (USD, float)&lt;br&gt;&lt;i&gt;Llamada manual; no está en obtener_dato_de_prueba&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=9;strokeColor=#B65E0A;fillColor=#FFF4E5;fontColor=#15283D;fontSize=19;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1522" y="695" width="425" height="192" as="geometry" /></mxCell><mxCell id="coutput" value="&lt;b&gt;Resultado opcional&lt;/b&gt;&lt;br&gt;costo USD" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=9;strokeColor=#B65E0A;fillColor=#FFFFFF;fontColor=#15283D;fontSize=20;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1980" y="706" width="181" height="150" as="geometry" /></mxCell><mxCell id="precios" value="&lt;b&gt;Tarifas&lt;/b&gt;&lt;br&gt;precio_entrada y precio_salida&lt;br&gt;parámetros externos" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=9;strokeColor=#B65E0A;fillColor=#FFFFFF;fontColor=#15283D;fontSize=17;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1550" y="908" width="350" height="100" as="geometry" /></mxCell><mxCell id="e1" value="&lt;b&gt;armar_peticion&lt;/b&gt;&lt;br&gt;ValueError para pregunta vacía.&lt;br&gt;Sin except local." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=9;strokeColor=#B42336;fillColor=#FFF0F1;fontColor=#15283D;fontSize=20;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1075" width="620" height="140" as="geometry" /></mxCell><mxCell id="e2" value="&lt;b&gt;enviar_peticion&lt;/b&gt;&lt;br&gt;try/except: Timeout y ConnectionError; HTTPError (400,401,403,otros); JSONDecodeError → RuntimeError" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=9;strokeColor=#B42336;fillColor=#FFF0F1;fontColor=#15283D;fontSize=20;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="682" y="1075" width="815" height="140" as="geometry" /></mxCell><mxCell id="e3" value="&lt;b&gt;extraer_texto&lt;/b&gt;&lt;br&gt;try/except: KeyError e IndexError → RuntimeError" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=9;strokeColor=#B42336;fillColor=#FFF0F1;fontColor=#15283D;fontSize=20;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1517" y="1075" width="642" height="140" as="geometry" /></mxCell><mxCell id="maincatch" value="&lt;b&gt;__main__: try obtener_dato_de_prueba(pregunta)&lt;/b&gt;&lt;br&gt;except (ValueError, RuntimeError) → print(error)&lt;br&gt;&lt;i&gt;Nota: calcular_costo puede emitir KeyError sin captura local, y no se llama en este flujo.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=9;strokeColor=#B42336;fillColor=#FFFFFF;fontColor=#15283D;fontSize=20;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="165" y="1270" width="1875" height="120" as="geometry" /></mxCell><mxCell id="fl1" value="pregunta: str" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175CD3;strokeWidth=3;fontColor=#175CD3;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="usuario" target="orq"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl2" value="pregunta: str" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175CD3;strokeWidth=3;fontColor=#175CD3;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="orq" target="armar"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl3" value="URL, headers, body" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175CD3;strokeWidth=3;fontColor=#175CD3;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="armar" target="enviar"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl4" value="datos: dict (JSON)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175CD3;strokeWidth=3;fontColor=#175CD3;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="enviar" target="extraer"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fl5" value="resultado: str" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175CD3;strokeWidth=3;fontColor=#175CD3;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="extraer" target="output"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="key" value="os.getenv → header" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#147D70;strokeWidth=3;fontColor=#147D70;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="env" target="armar"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="request" value="HTTP POST (headers + body)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#147D70;strokeWidth=3;fontColor=#147D70;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="enviar" target="api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="result" value="HTTP JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#147D70;strokeWidth=3;fontColor=#147D70;fontSize=15;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="api" target="enviar"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="costbranch" value="datos JSON / usageMetadata" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B65E0A;strokeWidth=3;fontColor=#B65E0A;fontSize=15;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="enviar" target="costo"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="costresult" value="costo: float" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B65E0A;strokeWidth=3;fontColor=#B65E0A;fontSize=15;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="costo" target="coutput"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="tariffs" value="precios por token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B65E0A;strokeWidth=3;fontColor=#B65E0A;fontSize=15;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="precios" target="costo"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="err1" value="ValueError" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B42336;strokeWidth=3;fontColor=#B42336;fontSize=15;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="e1" target="maincatch"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="err2" value="RuntimeError" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B42336;strokeWidth=3;fontColor=#B42336;fontSize=15;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="e2" target="maincatch"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="err3" value="RuntimeError" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#B42336;strokeWidth=3;fontColor=#B42336;fontSize=15;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=8 6;" edge="1" parent="1" source="e3" target="maincatch"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>